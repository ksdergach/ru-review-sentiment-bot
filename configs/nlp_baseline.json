{
  "seed": 42,
  "train_path": "data/processed/train.parquet",
  "validation_path": "data/processed/validation.parquet",
  "train_ids_path": null,
  "data_prep_audit_path": "reports/data_prep/audit.json",
  "data_prep_split_ids_path": "reports/data_prep/split_ids.csv",
  "report_dir": "reports/nlp/training",
  "model_dir": "models/nlp_baseline",
  "bundle_name": "tfidf_logreg_baseline.joblib",
  "label_mapping": {
    "negative": 0,
    "neutral": 1,
    "positive": 2
  },
  "text_column": "review_text",
  "label_column": "label_id",
  "id_column": "record_id",
  "text_processing": {
    "manual_normalization": "none",
    "truncation": null
  },
  "tfidf": {
    "analyzer": "word",
    "lowercase": true,
    "ngram_range": [
      1,
      2
    ],
    "min_df": 2,
    "max_df": 0.98,
    "max_features": 100000,
    "sublinear_tf": true,
    "norm": "l2",
    "use_idf": true,
    "smooth_idf": true,
    "token_pattern": "(?u)\\b\\w\\w+\\b"
  },
  "logistic_regression": {
    "C_values": [
      0.5,
      1.0,
      2.0
    ],
    "solver": "lbfgs",
    "max_iter": 1000,
    "tol": 0.0001,
    "class_weight_mode": "balanced_train"
  }
}
