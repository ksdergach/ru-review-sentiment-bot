{
  "seed": 42,
  "machine_label": "personal-pc-rtx4050",
  "paths": {
    "train_parquet": "data/processed/train.parquet",
    "train_ids_csv": "reports/baseline/train_ids.csv",
    "baseline_run_metadata": "reports/baseline/run_metadata.json",
    "split_ids_csv": "reports/data_prep/split_ids.csv",
    "reports_dir": "reports/resources",
    "local_artifacts_dir": "artifacts/resource_check"
  },
  "labels": {
    "negative": 0,
    "neutral": 1,
    "positive": 2
  },
  "rubert": {
    "model_name": "cointegrated/rubert-tiny2",
    "learning_rate": 2e-05,
    "weight_decay": 0.01,
    "training_steps": 3
  },
  "profiles": {
    "primary": {
      "rubert": {
        "device": "cuda",
        "batch_size": 8,
        "max_length": 256,
        "mixed_precision": "fp16"
      },
      "whisper": {
        "model_size": "small",
        "device": "cpu",
        "compute_type": "int8",
        "beam_size": 5,
        "vad_filter": true,
        "cpu_threads": 8
      }
    },
    "reserve": {
      "rubert": {
        "device": "cuda",
        "batch_size": 4,
        "max_length": 128,
        "mixed_precision": "fp16"
      },
      "whisper": {
        "model_size": "base",
        "device": "cpu",
        "compute_type": "int8",
        "beam_size": 1,
        "vad_filter": true,
        "cpu_threads": 6
      }
    }
  },
  "debug_audio": {
    "language": "ru",
    "max_seconds": 30,
    "max_bytes": 5242880
  },
  "remote_fallback": {
    "required_only_if_local_profiles_fail": true,
    "confirmed_by_human": false,
    "provider": null,
    "note": "Не считать удалённый GPU доступным, пока участник команды явно не подтвердит его."
  }
}
