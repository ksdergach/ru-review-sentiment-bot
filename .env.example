# Template only. Current T03/T04/T05 commands do not automatically read .env.
# Export these variables in your shell when needed (see README).
# Used by the text Telegram bot (python -m src.bot); never commit a real token.
TELEGRAM_BOT_TOKEN=

# Relative to the repository root when running the documented commands.
HF_HOME=.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1

# Backend is fixed on the first prediction. Restart after changing it.
CLASSIFIER_BACKEND=baseline
# Optional: baseline file or RuBERT directory. Empty means the documented default.
CLASSIFIER_MODEL_PATH=
# Optional: run_metadata.json of the run that produced CLASSIFIER_MODEL_PATH (checksums, data version).
CLASSIFIER_REPORT_PATH=
